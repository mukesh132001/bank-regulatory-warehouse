# Copy this file to .env and replace every "change-me" value.
# .env is git-ignored: real passwords never go into the repo.
# Used by: the Python scripts (via python-dotenv), scripts/dbt.py, and Docker Compose.

# --- Warehouse database (Postgres) ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bank_dw
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=change-me

# Read-only dashboard role created by sql/security/01_reader_role.sql
METABASE_READER_PASSWORD=change-me-too

# --- S3 landing zone ----------------------------------------------------------
S3_BUCKET=bank-dw-landing
S3_PREFIX=raw
# These point boto3 at the local S3 emulator in docker-compose (dummy keys, not secrets).
# For real AWS S3: remove AWS_ENDPOINT_URL and use your own credentials or AWS profile.
AWS_ENDPOINT_URL=http://localhost:5050
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Airflow ----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
# Any long random string:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me
# Optional, encrypts Airflow connections:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Linux only: set to your user id (`id -u`) so files Airflow writes are owned by you.
# macOS / Windows: leave as 50000.
AIRFLOW_UID=50000
# Optional: Slack-compatible incoming webhook that receives failure alerts.
ALERT_WEBHOOK_URL=
